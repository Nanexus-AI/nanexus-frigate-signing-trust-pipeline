{
  "schema": 1,
  "frigate_version": "0.18.2-cfa08c5",
  "api_origin": "https://127.0.0.1:8971",
  "browser_origin": "https://127.0.0.1:18991",
  "instance_certificate": "/nanexus/instance.pem",
  "listen": {
    "live_host": "127.0.0.1",
    "live_port": 18774,
    "historical_host": "127.0.0.1",
    "historical_port": 8766
  },
  "token_file": "/nanexus/private/live.token",
  "ffmpeg": "/usr/lib/ffmpeg/8.0/bin/ffmpeg",
  "ffprobe": "/usr/lib/ffmpeg/8.0/bin/ffprobe",
  "policy": {
    "policy_id": "c210-gateway-shared-9",
    "evaluation_interval": 0.1,
    "active_freshness_limit": 2.0,
    "observation_horizon": 6.0,
    "media_silence_limit": 1.5
  },
  "supervision": {
    "poll_seconds": 0.2,
    "backoff_initial_seconds": 0.5,
    "backoff_max_seconds": 5.0
  },
  "cameras": [
    {
      "camera": "source_camera",
      "stream": "signed_source",
      "context": "grid",
      "rendition": "signed-main",
      "source_id": "operator-source",
      "revision": "operator-revision-1",
      "rtsp_url": "rtsp://REPLACE_SIGNING_SOURCE_HOST:REPLACE_PORT/REPLACE_SIGNED_PATH"
    }
  ],
  "historical": {
    "media_root": "/nanexus/recordings",
    "scratch_root": "/nanexus/scratch",
    "public_ca": "/nanexus/trust/ca.pem",
    "worker": "/REPLACE_SELECTED_HOST_WORKER",
    "worker_sha256": "REPLACE_BY_EXPLICIT_PAIR_SELECTION"
  },
  "state_root": "/nanexus/state"
}
